# Copy to .env (chmod 600). Only the owner's busy/free feed; no participant data.
ICS_URL=https://outlook.office365.com/owa/calendar/<id>@<domain>/<token>/calendar.ics
# CACHE_SECONDS=30
# REQUIRE_HEARTBEAT=1   # 1 = booking only while the Power Automate heartbeat is fresh (default); 0 while setting it up
