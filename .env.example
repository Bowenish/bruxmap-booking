# Copy to .env (chmod 600). Only the owner's busy/free feed; no participant data.
ICS_URL=https://outlook.office365.com/owa/calendar/<id>@<domain>/<token>/calendar.ics
# CACHE_SECONDS=30
# REQUIRE_HEARTBEAT=1   # 1 = booking only while the Power Automate heartbeat is fresh (default); 0 while setting it up
# Optional: how long a slot is reserved while a visitor fills the form (seconds), and holds per address
# HOLD_SECONDS=600
# HOLD_PER_IP=5           # several visitors can share one address on campus
# HOLD_FORM_SECONDS=1800  # the slot stays hidden this long after a visitor reached the form (covers Flow B + the feed's publish lag)
# HOLD_MAX_SECONDS=3600   # no hold lives longer than this, renewals included
# HOLDS_FILE=/home/bruxmap_booking/holds.json   # holds survive restarts (default: next to server.py); empty = memory only
# POLL_SECONDS=10         # how often an open page re-reads the slots
